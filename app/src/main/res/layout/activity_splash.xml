<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#48CAE4"
   >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:contentDescription="Hostel Finder Logo"
            android:src="@drawable/host" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Hostel Finder"
            android:textColor="#172554"
            android:textSize="35sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Find Your Perfect&#10;Hostel Near Campus"
            android:textColor="#475569"
            android:textSize="20sp" />

        <ProgressBar
            android:id="@+id/splashProgress"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="55dp" />

    </LinearLayout>

</FrameLayout>