<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7FF">

    <!-- MAIN SCROLL AREA -->

    <ScrollView
        android:id="@+id/profile_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/owner_profile_nav"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- HEADER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/back_button"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="32sp"
                    android:textColor="#1E3A8A"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Owner Profile"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#111827" />

                <View
                    android:layout_width="45dp"
                    android:layout_height="45dp" />

            </LinearLayout>


            <!-- PROFILE HEADER CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="#FFFFFF">

                <!-- PROFILE IMAGE -->

                <ImageView
                    android:id="@+id/owner_profile_image"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:padding="18dp"
                    android:contentDescription="Owner profile photo"
                    android:background="#E8F0FE" />

                <TextView
                    android:id="@+id/profile_business_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Green View Properties"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#111827" />

                <TextView
                    android:id="@+id/profile_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hostel Owner"
                    android:textSize="14sp"
                    android:textColor="#2563EB" />

                <TextView
                    android:id="@+id/profile_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="● Verified Owner"
                    android:textSize="13sp"
                    android:textColor="#10B981" />

            </LinearLayout>


            <!-- BUSINESS INFORMATION -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Business Information"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111827" />


            <!-- BUSINESS NAME -->

            <LinearLayout
                android:id="@+id/business_name_row"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="B"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"
                    android:background="#E8F0FE" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Business Name"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/business_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Green View Properties"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                </LinearLayout>

            </LinearLayout>


            <!-- OWNER NAME -->

            <LinearLayout
                android:id="@+id/owner_name_row"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="P"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"
                    android:background="#E8F0FE" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Owner Name"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/owner_full_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="John Doe"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                </LinearLayout>

            </LinearLayout>


            <!-- PHONE -->

            <LinearLayout
                android:id="@+id/phone_row"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="☎"
                    android:textSize="18sp"
                    android:textColor="#10B981"
                    android:background="#E8F8F1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Number"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/owner_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="+256 700 000 000"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                </LinearLayout>

            </LinearLayout>


            <!-- EMAIL -->

            <LinearLayout
                android:id="@+id/email_row"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="@"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"
                    android:background="#E8F0FE" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Address"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/owner_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="owner@gmail.com"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                </LinearLayout>

            </LinearLayout>


            <!-- LOCATION -->

            <LinearLayout
                android:id="@+id/location_row"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="⌖"
                    android:textSize="22sp"
                    android:textColor="#F59E0B"
                    android:background="#FFF7E6" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/owner_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Kampala, Uganda"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                </LinearLayout>

            </LinearLayout>


            <!-- ACCOUNT SETTINGS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Account"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111827" />


            <!-- EDIT PROFILE -->

            <LinearLayout
                android:id="@+id/edit_profile"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="✎"
                    android:textSize="19sp"
                    android:textColor="#2563EB"
                    android:background="#E8F0FE" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Edit Profile"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#111827" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="26sp"
                    android:textColor="#64748B" />

            </LinearLayout>


            <!-- CHANGE PASSWORD -->

            <LinearLayout
                android:id="@+id/change_password"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="🔒"
                    android:textSize="17sp"
                    android:background="#E8F0FE" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Change Password"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#111827" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="26sp"
                    android:textColor="#64748B" />

            </LinearLayout>


            <!-- NOTIFICATIONS -->

            <LinearLayout
                android:id="@+id/notifications"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="!"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#F59E0B"
                    android:background="#FFF7E6" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Notifications"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#111827" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="26sp"
                    android:textColor="#64748B" />

            </LinearLayout>


            <!-- SUPPORT -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Support"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111827" />


            <!-- HELP -->

            <LinearLayout
                android:id="@+id/help_support"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">



                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Help and Support"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#111827" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="26sp"
                    android:textColor="#64748B" />

            </LinearLayout>


            <!-- LOGOUT -->

            <LinearLayout
                android:id="@+id/logout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- BOTTOM NAVIGATION -->

    <LinearLayout
        android:id="@+id/owner_profile_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="10dp">


        <!-- HOME -->

        <LinearLayout
            android:id="@+id/nav_profile_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textSize="24sp"
                android:textColor="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>


        <!-- BOOKINGS -->

        <LinearLayout
            android:id="@+id/nav_profile_bookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textSize="21sp"
                android:textColor="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bookings"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>


        <!-- LISTINGS -->

        <LinearLayout
            android:id="@+id/nav_profile_listings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textSize="21sp"
                android:textColor="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listings"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>


        <!-- PROFILE - ACTIVE -->

        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="20sp"
                android:textColor="#2563EB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2563EB" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>