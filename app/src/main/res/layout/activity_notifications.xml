<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F7FF">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notifications_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notifications"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1E3A8A" />

            <TextView
                android:id="@+id/notification_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 unread notifications"
                android:textSize="14sp"
                android:textColor="#64748B"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/mark_all_read"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="Mark all read"
            android:textSize="12sp"
            android:textColor="#1D4ED8"
            android:backgroundTint="#EFF6FF" />

    </LinearLayout>

    <!-- Notifications -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/notification_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Notification 1 -->
            <LinearLayout
                android:id="@+id/notification_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/notification_icon_1"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#1D4ED8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/notification_title_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Booking Confirmed"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <TextView
                        android:id="@+id/notification_message_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your booking at Sunrise Hostel has been confirmed."
                        android:textSize="14sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/notification_time_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 minutes ago"
                        android:textSize="12sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Notification 2 -->
            <LinearLayout
                android:id="@+id/notification_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/notification_icon_2"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="!"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#10B981" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/notification_title_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="New Hostel Available"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <TextView
                        android:id="@+id/notification_message_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A new hostel matching your saved preferences is available."
                        android:textSize="14sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/notification_time_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 hour ago"
                        android:textSize="12sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Notification 3 -->
            <LinearLayout
                android:id="@+id/notification_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/notification_icon_3"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="★"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#F59E0B" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/notification_title_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Special Hostel Offer"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <TextView
                        android:id="@+id/notification_message_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Check out discounted rooms available near your university."
                        android:textSize="14sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/notification_time_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yesterday"
                        android:textSize="12sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="7dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/empty_notifications"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textSize="45sp"
                    android:textColor="#1D4ED8" />

                <TextView
                    android:id="@+id/empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You're all caught up!"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No new notifications at the moment."
                    android:textSize="14sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Home"
            android:textColor="#64748B"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/nav_saved"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Saved"
            android:textColor="#64748B"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/nav_bookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Bookings"
            android:textColor="#64748B"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Profile"
            android:textColor="#64748B"
            android:backgroundTint="#FFFFFF" />

    </LinearLayout>

</LinearLayout>