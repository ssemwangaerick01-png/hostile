<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F7FF">

    <!-- =============================== -->
    <!-- HEADER -->
    <!-- =============================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/back2"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:contentDescription="Back"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/bookings_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Bookings"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A"
            android:gravity="center" />

        <View
            android:layout_width="45dp"
            android:layout_height="45dp" />

    </LinearLayout>


    <!-- =============================== -->
    <!-- BOOKING FILTERS -->
    <!-- =============================== -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/upcoming_button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Upcoming"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1D4ED8" />

            <Button
                android:id="@+id/completed_button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="Completed"
                android:textColor="#1D4ED8"
                android:backgroundTint="#FFFFFF" />

            <Button
                android:id="@+id/cancelled_button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="Cancelled"
                android:textColor="#1D4ED8"
                android:backgroundTint="#FFFFFF" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- =============================== -->
    <!-- CONTENT -->
    <!-- =============================== -->

    <ScrollView
        android:id="@+id/bookings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/bookings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- =============================== -->
            <!-- UPCOMING TITLE -->
            <!-- =============================== -->

            <TextView
                android:id="@+id/section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upcoming Bookings"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#111827" />


            <!-- =============================== -->
            <!-- BOOKING CARD -->
            <!-- =============================== -->

            <LinearLayout
                android:id="@+id/booking_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginTop="12dp">

                <!-- Hostel Image -->

                <ImageView
                    android:id="@+id/booking_image"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:src="@drawable/room1"
                    android:scaleType="centerCrop"
                    android:contentDescription="Hostel image" />


                <!-- Hostel Name -->

                <TextView
                    android:id="@+id/booking_hostel_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sunrise Hostel"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginTop="12dp" />


                <!-- Location -->

                <TextView
                    android:id="@+id/booking_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Kisaasi, Kampala"
                    android:textSize="14sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="4dp" />


                <!-- Booking ID -->

                <TextView
                    android:id="@+id/booking_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking ID: HF-2026-0012"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="5dp" />


                <!-- Room -->

                <TextView
                    android:id="@+id/booking_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room: A12"
                    android:textSize="14sp"
                    android:textColor="#475569"
                    android:layout_marginTop="10dp" />


                <!-- Duration -->

                <TextView
                    android:id="@+id/booking_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duration: 1 Semester"
                    android:textSize="14sp"
                    android:textColor="#475569"
                    android:layout_marginTop="4dp" />


                <!-- Price -->

                <TextView
                    android:id="@+id/booking_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UGX 800,000"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1D4ED8"
                    android:layout_marginTop="8dp" />


                <!-- Payment -->

                <TextView
                    android:id="@+id/booking_payment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paid via MTN Mobile Money"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="4dp" />


                <!-- Status -->

                <TextView
                    android:id="@+id/booking_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Confirmed"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#15803D"
                    android:layout_marginTop="10dp" />


                <!-- Buttons -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/view_booking_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="View Details"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1D4ED8" />

                    <Button
                        android:id="@+id/cancel_booking_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Cancel"
                        android:textColor="#DC2626"
                        android:backgroundTint="#FFFFFF" />

                </LinearLayout>

            </LinearLayout>


            <!-- =============================== -->
            <!-- EMPTY STATE -->
            <!-- =============================== -->

            <LinearLayout
                android:id="@+id/no_bookings_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="35dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/no_bookings_image"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/host"
                    android:contentDescription="No bookings" />

                <TextView
                    android:id="@+id/no_bookings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No bookings yet"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginTop="15dp" />

                <TextView
                    android:id="@+id/no_bookings_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Find a hostel and make your first booking today."
                    android:textSize="14sp"
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/find_hostel_button"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="Find a Hostel"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1D4ED8"
                    android:layout_marginTop="18dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- =============================== -->
    <!-- BOTTOM NAVIGATION -->
    <!-- =============================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Home"
            android:textColor="#64748B"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/nav_saved"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Saved"
            android:textColor="#64748B"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/nav_bookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Bookings"
            android:textColor="#1D4ED8"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Profile"
            android:textColor="#64748B"
            android:backgroundTint="#FFFFFF" />

    </LinearLayout>

</LinearLayout>