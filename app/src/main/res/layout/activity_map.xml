<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hostels Near You"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A" />

        <TextView
            android:id="@+id/map_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🔍"
            android:textSize="20sp" />

    </LinearLayout>

    <!-- Map -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Selected Hostel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:orientation="vertical"
        android:padding="15dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/selected_hostel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Galaxy Hostel"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:id="@+id/hostel_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kansanga, Kampala"
            android:textSize="14sp"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/hostel_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="UGX 250,000 / month"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A" />

        <Button
            android:id="@+id/view_details_btn"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="8dp"
            android:text="View Details"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F22D8" />

    </LinearLayout>

</LinearLayout>