<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F7FF">

    <!-- ===================================== -->
    <!-- TOP BAR -->
    <!-- ===================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:background="#FFFFFF"
        android:elevation="3dp">

        <!-- Back Button -->

        <ImageButton
            android:id="@+id/backbutton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/back2"
            android:scaleType="fitCenter" />

        <!-- Title -->

        <TextView
            android:id="@+id/search_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Search Hostels"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E3A8A" />

        <!-- Right Spacer -->

        <View
            android:layout_width="45dp"
            android:layout_height="45dp" />

    </LinearLayout>


    <!-- ===================================== -->
    <!-- SCROLLABLE CONTENT -->
    <!-- ===================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="25dp">


            <!-- ===================================== -->
            <!-- SEARCH SECTION -->
            <!-- ===================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">


                <!-- Search Box -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/search_background">

                    <!-- Search Icon -->

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/search"
                        android:contentDescription="Search icon" />


                    <!-- Search Input -->

                    <EditText
                        android:id="@+id/search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:hint="Search hostel or area"
                        android:textSize="15sp"
                        android:singleLine="true"
                        android:inputType="text"
                        android:background="@android:color/transparent"
                        android:padding="0dp"
                        android:textColor="#111827"
                        android:textColorHint="#94A3B8" />


                    <!-- Clear Button -->

                    <ImageButton
                        android:id="@+id/clear_search"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/close"
                        android:background="@android:color/transparent"
                        android:contentDescription="Clear search"
                        android:padding="8dp"
                         />

                </LinearLayout>


                <!-- ===================================== -->
                <!-- FILTER TITLE -->
                <!-- ===================================== -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter by location"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp" />


                <!-- ===================================== -->
                <!-- DISTRICT + AREA -->
                <!-- ===================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <!-- District -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/filter_background">

                        <Spinner
                            android:id="@+id/district_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="8dp" />

                    </LinearLayout>


                    <!-- Area -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/filter_background">

                        <Spinner
                            android:id="@+id/area_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="8dp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ===================================== -->
                <!-- UNIVERSITY -->
                <!-- ===================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/filter_background">

                    <Spinner
                        android:id="@+id/university_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="8dp" />

                </LinearLayout>


                <!-- ===================================== -->
                <!-- MORE FILTERS -->
                <!-- ===================================== -->

                <Button
                    android:id="@+id/more_filters_button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:text="⚙  More Filters"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1D4ED8"
                    android:backgroundTint="#DBEAFE" />


                <!-- ===================================== -->
                <!-- SEARCH BUTTON -->
                <!-- ===================================== -->

                <Button
                    android:id="@+id/filter_button"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:text="🔍  Search Hostels"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1D4ED8" />

            </LinearLayout>


            <!-- ===================================== -->
            <!-- RESULTS HEADER -->
            <!-- ===================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp">


                <!-- Results Count -->

                <TextView
                    android:id="@+id/results_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="24 Hostels Found"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#111827" />


                <!-- Sort -->

                <LinearLayout
                    android:layout_width="125dp"
                    android:layout_height="45dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/filter_background">

                    <Spinner
                        android:id="@+id/sort_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="5dp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ===================================== -->
            <!-- HOSTEL RESULTS -->
            <!-- ===================================== -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hostel_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />


            <!-- ===================================== -->
            <!-- EMPTY RESULTS -->
            <!-- ===================================== -->

            <LinearLayout
                android:id="@+id/no_results_layout"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="30dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/search"
                    android:alpha="0.5"
                    android:contentDescription="No results" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No hostels found"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#334155" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="Try changing your search or filters."
                    android:textSize="14sp"
                    android:textColor="#64748B" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</LinearLayout>