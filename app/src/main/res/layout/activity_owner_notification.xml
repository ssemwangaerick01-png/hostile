<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7FF">

    <!-- MAIN CONTENT -->

    <ScrollView
        android:id="@+id/notifications_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/notification_bottom_nav"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <!-- HEADER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/back_button"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="32sp"
                    android:textColor="#1E3A8A"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Notifications"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#111827" />

                <TextView
                    android:id="@+id/mark_all_read"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mark all"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>


            <!-- SUMMARY -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF">

                <TextView
                    android:id="@+id/unread_count"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="4"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#2563EB" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unread Notifications"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Stay updated with your hostel activity"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                </LinearLayout>

            </LinearLayout>


            <!-- TODAY -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Today"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111827" />


            <!-- NEW BOOKING -->

            <LinearLayout
                android:id="@+id/notification_booking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"
                    android:background="#E8F0FE" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Booking Request"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sarah N. requested a room at Green View Properties."
                        android:textSize="13sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="10 minutes ago"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

                <TextView
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#2563EB"
                    android:text="" />

            </LinearLayout>


            <!-- PAYMENT -->

            <LinearLayout
                android:id="@+id/notification_payment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#10B981"
                    android:background="#E8F8F1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment Received"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="UGX 350,000 payment received from Brian K."
                        android:textSize="13sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="1 hour ago"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

                <TextView
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="#2563EB"
                    android:text="" />

            </LinearLayout>


            <!-- NEW REVIEW -->

            <LinearLayout
                android:id="@+id/notification_review"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="★"
                    android:textSize="22sp"
                    android:textColor="#F59E0B"
                    android:background="#FFF7E6" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Tenant Review"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sandra N. gave Green View Properties a 5-star review."
                        android:textSize="13sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="3 hours ago"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

            </LinearLayout>


            <!-- YESTERDAY -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Yesterday"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111827" />


            <!-- ROOM AVAILABILITY -->

            <LinearLayout
                android:id="@+id/notification_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="%"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#F59E0B"
                    android:background="#FFF7E6" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Room Availability Update"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Room B12 is now available for booking."
                        android:textSize="13sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Yesterday, 4:30 PM"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

            </LinearLayout>


            <!-- LISTING APPROVED -->

            <LinearLayout
                android:id="@+id/notification_listing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#10B981"
                    android:background="#E8F8F1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Listing Approved"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Your new hostel listing has been approved and is now visible to students."
                        android:textSize="13sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Yesterday, 11:20 AM"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

            </LinearLayout>


            <!-- SYSTEM -->

            <LinearLayout
                android:id="@+id/notification_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="i"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"
                    android:background="#E8F0FE" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hostel Finder Update"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Keep your hostel information and room availability up to date."
                        android:textSize="13sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Yesterday, 9:00 AM"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- BOTTOM NAVIGATION -->

    <LinearLayout
        android:id="@+id/notification_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="10dp">


        <!-- HOME -->

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textSize="24sp"
                android:textColor="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>


        <!-- BOOKINGS -->

        <LinearLayout
            android:id="@+id/nav_bookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textSize="21sp"
                android:textColor="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bookings"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>


        <!-- LISTINGS -->

        <LinearLayout
            android:id="@+id/nav_listings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textSize="21sp"
                android:textColor="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listings"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>


        <!-- PROFILE -->

        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="20sp"
                android:textColor="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="11sp"
                android:textColor="#64748B" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>