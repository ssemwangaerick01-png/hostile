<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- =============================== -->
        <!-- HEADER -->
        <!-- =============================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/back2"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/booking_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Book Hostel"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#1E3A8A" />

            <View
                android:layout_width="45dp"
                android:layout_height="45dp" />

        </LinearLayout>


        <!-- =============================== -->
        <!-- HOSTEL SUMMARY -->
        <!-- =============================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hostel_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/booking_hostel_image"
                    android:layout_width="110dp"
                    android:layout_height="100dp"
                    android:src="@drawable/room1"
                    android:scaleType="centerCrop"
                    android:contentDescription="Hostel image" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/booking_hostel_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sunrise Hostel"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <TextView
                        android:id="@+id/booking_hostel_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Kisaasi, Kampala"
                        android:textSize="14sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="5dp" />

                    <TextView
                        android:id="@+id/booking_hostel_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ 4.7 • 0.8 km away"
                        android:textSize="14sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/booking_hostel_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UGX 800,000 / semester"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1D4ED8"
                        android:layout_marginTop="5dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- =============================== -->
        <!-- BOOKING DETAILS -->
        <!-- =============================== -->

        <TextView
            android:id="@+id/booking_details_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking Details"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginTop="22dp" />


        <!-- ROOM -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Room"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/room_spinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#FFFFFF"
            android:padding="8dp" />


        <!-- DURATION -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking Duration"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/duration_spinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#FFFFFF"
            android:padding="8dp" />


        <!-- =============================== -->
        <!-- STUDENT INFORMATION -->
        <!-- =============================== -->

        <TextView
            android:id="@+id/student_information_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Information"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginTop="22dp" />


        <EditText
            android:id="@+id/student_name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:layout_marginTop="12dp" />


        <EditText
            android:id="@+id/student_phone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Phone Number"
            android:inputType="phone"
            android:singleLine="true"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:layout_marginTop="10dp" />


        <EditText
            android:id="@+id/student_university"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="University / Institution"
            android:inputType="text"
            android:singleLine="true"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:layout_marginTop="10dp" />


        <EditText
            android:id="@+id/student_id"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Student ID"
            android:inputType="text"
            android:singleLine="true"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:layout_marginTop="10dp" />


        <!-- =============================== -->
        <!-- PAYMENT -->
        <!-- =============================== -->

        <TextView
            android:id="@+id/payment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Method"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginTop="22dp" />

        <RadioGroup
            android:id="@+id/payment_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/mtn_payment"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="MTN Mobile Money"
                android:textSize="15sp"
                android:textColor="#111827" />

            <RadioButton
                android:id="@+id/airtel_payment"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Airtel Money"
                android:textSize="15sp"
                android:textColor="#111827" />

        </RadioGroup>


        <!-- PAYMENT NUMBER -->

        <EditText
            android:id="@+id/payment_phone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Mobile Money Number"
            android:inputType="phone"
            android:singleLine="true"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:layout_marginTop="8dp" />


        <!-- =============================== -->
        <!-- NOTES -->
        <!-- =============================== -->

        <TextView
            android:id="@+id/notes_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Additional Notes"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginTop="22dp" />

        <EditText
            android:id="@+id/booking_notes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Any special requests or information..."
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:layout_marginTop="10dp" />


        <!-- =============================== -->
        <!-- BOOKING SUMMARY -->
        <!-- =============================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/booking_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
           >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking Summary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111827" />

                <TextView
                    android:id="@+id/summary_room"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Room: Not selected"
                    android:textSize="14sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/summary_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Duration: Not selected"
                    android:textSize="14sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/summary_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accommodation: UGX 800,000"
                    android:textSize="14sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/summary_service_fee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Service Fee: UGX 10,000"
                    android:textSize="14sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/summary_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total: UGX 810,000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1D4ED8"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- =============================== -->
        <!-- TERMS -->
        <!-- =============================== -->

        <CheckBox
            android:id="@+id/terms_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I agree to the booking terms and conditions"
            android:textSize="14sp"
            android:textColor="#475569"
            android:layout_marginTop="15dp" />


        <!-- =============================== -->
        <!-- CONFIRM BOOKING -->
        <!-- =============================== -->

        <Button
            android:id="@+id/confirm_booking"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Confirm Booking"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D4ED8"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="25dp" />

    </LinearLayout>

</ScrollView>