<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Main Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <ImageView
                    android:id="@+id/detailImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/room1" />

                <!-- Circular Back Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/backButtonCard"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#CCFFFFFF">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="#1E293B" />
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- White Content Sheet -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="-25dp"
                android:background="@drawable/input_shape"
                android:elevation="4dp">

                <!-- Header: Name and Rating -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/detailName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Green View Hostel"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 4.8"
                        android:textColor="#F59E0B"
                        android:textStyle="bold"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detailLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Kikoni, Kampala • 5 mins walk to Campus"
                    android:textSize="14sp"
                    android:textColor="#64748B" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Description"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <TextView
                    android:id="@+id/detailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Stay in a premium environment designed for students. This room includes modern furnishings, a dedicated study area, and optimized lighting."
                    android:textSize="15sp"
                    android:textColor="#475569"
                    android:lineSpacingExtra="5dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="What this offers"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:layout_marginTop="16dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@android:drawable/ic_menu_rotate" app:tint="#2563EB" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fast Wi-Fi" android:textSize="12sp" android:layout_marginTop="6dp" android:textColor="#475569" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@android:drawable/ic_lock_idle_lock" app:tint="#2563EB" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24/7 Security" android:textSize="12sp" android:layout_marginTop="6dp" android:textColor="#475569" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <ImageView android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#2563EB" />
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kitchen"
                            android:textSize="12sp"
                            android:layout_marginTop="6dp"
                            android:textColor="#475569" />
                    </LinearLayout>
                </GridLayout>

                <Space android:layout_width="match_parent" android:layout_height="40dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Fixed Bottom Booking Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="20dp"
        app:cardCornerRadius="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="18dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Price"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05" />
                <TextView
                    android:id="@+id/detailPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UGX 1,500,000"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB" />
            </LinearLayout>

            <Button
                android:id="@+id/bookButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:text="BOOK NOW"
                android:textStyle="bold"
                android:backgroundTint="#2563EB"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>