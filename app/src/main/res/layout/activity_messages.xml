<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8FC">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/back2"
            android:contentDescription="Back"
            android:scaleType="fitCenter"/>

        <!-- Header Icon -->
        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="💬"
            android:textSize="21sp"
            android:background="@drawable/search_background" />

        <!-- Header Text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Messages"
                android:textColor="#172B4D"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hostel Manager"
                android:textColor="#718096"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- More Button -->
        <ImageButton
            android:id="@+id/more_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/more"
            android:contentDescription="More options"
            android:scaleType="fitCenter"/>

    </LinearLayout>


    <!-- CHAT AREA -->
    <ScrollView
        android:id="@+id/chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chat_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- DATE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Today"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/message_sent"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp" />


            <!-- RECEIVED MESSAGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hostel Manager"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/message_received"
                    android:padding="12dp"
                    android:maxWidth="310dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello! Welcome to our hostel. How can I help you today?"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="10:30 AM"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:layout_marginTop="5dp" />

                </LinearLayout>

            </LinearLayout>


            <!-- SENT MESSAGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/message_sent"
                    android:padding="12dp"
                    android:maxWidth="310dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello! I would like to know if you have any rooms available."
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:lineSpacingExtra="2dp" />

                    <!-- TIME + READ STATUS -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10:31 AM"
                            android:textColor="#DCE8FF"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓✓"
                            android:textColor="#93C5FD"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="5dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- RECEIVED MESSAGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hostel Manager"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/message_received"
                    android:padding="12dp"
                    android:maxWidth="310dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yes, we currently have two rooms available. I can send you the room details."
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:text="10:32 AM"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:layout_marginTop="5dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- MESSAGE INPUT AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- Attach Button -->
        <ImageButton
            android:id="@+id/attach_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_add"
            android:tint="#64748B"
            android:contentDescription="Attach file" />

        <!-- Message Input -->
        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Write a message..."
            android:textSize="14sp"
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:singleLine="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/search_background" />

        <!-- Send Button -->
        <ImageButton
            android:id="@+id/send_message"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="#7DF9FF"
            android:src="@drawable/send"
            android:contentDescription="Send message"
            android:scaleType="fitCenter"/>

    </LinearLayout>

</LinearLayout>